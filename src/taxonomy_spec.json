{
 "source": "tsseg docs/_ext/tsseg_taxonomy.py (scripts/sync_taxonomy.py)",
 "searches": [
  {
   "key": "profile",
   "task": "cpd",
   "name": "Profile + peaks",
   "short": "A score at every time point, computed once; change points at its peaks.",
   "long": "The series is scanned once to compute a score at every time point: the discrepancy between two adjacent windows, a novelty score, or how many nearest-neighbour arcs cross the point. Change points are placed at the peaks of this profile, above a threshold or the highest ones."
  },
  {
   "key": "bottomup",
   "task": "cpd",
   "name": "Bottom-up",
   "short": "From a fine partition, merge the most similar adjacent segments.",
   "long": "Start from many small segments and repeatedly merge the two adjacent segments whose union costs least, until the next merge costs more than a penalty or the requested number of segments is reached."
  },
  {
   "key": "binseg",
   "task": "cpd",
   "name": "Binary segmentation",
   "short": "Top-down: split where the gain is largest, recursively.",
   "long": "Find the single best split of the series, then search again inside each part. Wild and seeded binary segmentation search random or seeded sub-intervals instead, to recover change points close to each other."
  },
  {
   "key": "convex",
   "task": "cpd",
   "name": "Convex relaxation",
   "short": "ℓ₁ penalty on the jumps of a piecewise fit.",
   "long": "Fit a piecewise model (level, trend) with an ℓ₁ penalty on its jumps, as in the fused lasso: most jumps are exactly zero, and the others are the change points."
  },
  {
   "key": "optimal",
   "task": "cpd",
   "dp": true,
   "name": "Optimal (DP)",
   "short": "Exact best segmentation (min over all segmentations).",
   "long": "Minimise the sum of the segment costs over all segmentations, with a penalty per change point or a fixed number of them, by dynamic programming over the position of the last change point. PELT prunes the candidates that can no longer win."
  },
  {
   "key": "bayes",
   "task": "cpd",
   "dp": true,
   "name": "Bayesian (DP)",
   "short": "Posterior over segmentations (sum), exact by DP or sampled by MCMC.",
   "long": "Put a prior on segmentations (product partition, or a left-to-right hidden Markov model) and compute the posterior probability of a change at each point: by the recursion of the optimal search with sums in place of minima, or by Markov chain Monte Carlo."
  },
  {
   "key": "states",
   "task": "sd",
   "dp": true,
   "name": "State sequence (DP)",
   "short": "A state per step or window, tied to the next one by a transition cost.",
   "long": "One hidden state per time step (per window in TICC, per block of the reduced series in HDP-HSMM), linked to the next by a transition model or a switching cost. Viterbi, forward–backward or Gibbs sampling runs over the whole sequence, so a state can come back."
  },
  {
   "key": "seggroup",
   "task": "sd",
   "name": "Segment, then group",
   "short": "Change points first, then similar segments share a state.",
   "long": "Detect change points first, then compare the segments: the segments that are alike receive the same state label."
  },
  {
   "key": "cluster",
   "task": "sd",
   "name": "Window clustering",
   "short": "Each window or point clustered on its own; time order ignored or in features only.",
   "long": "Each time point or window is labelled by a clustering (k-means, Gaussian or Dirichlet process mixture). Time order is ignored, or enters only the representation, for instance through contrastive pairs of adjacent windows."
  }
 ],
 "criteria": [
  {
   "key": "model",
   "tag": "model",
   "name": "Model of the observations",
   "short": "Likelihood or fit of a model (mean, variance, AR, trend, …).",
   "long": "Two parts differ when a specified model fits them with different parameters: mean, median, covariance, precision graph, regression or autoregression, trend, subspace, local intrinsic dimension."
  },
  {
   "key": "distrib",
   "tag": "distribution",
   "name": "Distribution, model-free",
   "short": "Kernel, energy, Wasserstein, density ratio, classifier or graph.",
   "long": "Empirical distributions are compared without a parametric model: characteristic kernel, energy distance, isolation kernel, density ratio, a classifier trained to tell the parts apart, or a graph."
  },
  {
   "key": "shapes",
   "tag": "subsequence shapes",
   "name": "Subsequence shapes",
   "short": "Nearest neighbours, classifiers or symbolic patterns of subsequences.",
   "long": "z-normalised subsequences are compared to their nearest neighbours (matrix-profile arcs, k-NN classifiers) or described by symbolic patterns: two parts differ when their local shapes do."
  },
  {
   "key": "learned",
   "tag": "learned representation",
   "name": "Learned representations",
   "short": "Windows embedded by a trained network.",
   "long": "A network (autoencoder, contrastive encoder, learned kernel) maps windows to embeddings, and the embeddings are compared."
  }
 ],
